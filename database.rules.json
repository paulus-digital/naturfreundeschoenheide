{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "pendingReviews": {
      ".read": "auth != null",
      ".write": true,
      "$reviewId": {
        ".validate": "newData.hasChildren(['name', 'rating', 'comment']) && newData.child('name').isString() && newData.child('rating').isNumber()"
      }
    }
  }
}
